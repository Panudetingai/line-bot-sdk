{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "typescript",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["typescript/**/*.ts"],
  "exclude": ["typescript/scripts"]
}
